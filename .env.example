# 生产部署配置示例：默认使用用户自己的反向代理。
# 首次部署运行：./deploy.sh install https://rp.example.com
# 也可先复制本文件为 .env 并填写配置；install 会在构建前补齐缺失的模型配置和随机密钥。
# 仅生成配置、不启动服务时使用：./deploy.sh configure https://rp.example.com
# 本地开发使用 ./dev.sh 或 pnpm dev，开发入口不读取此配置。
# 模型 API 密钥在网页「设置 → 模型」填写，或放入 secrets/models.env。

# Compose 项目名，用于区分容器、网络与卷。
COMPOSE_PROJECT_NAME=pi-roleplay

# 最终访问地址，填写完整 origin，不带路径或末尾斜杠。
RP_PUBLIC_ORIGIN=https://rp.example.com

# 留空使用外部反代；填 caddy 启用内置 Caddy。
# 已有部署可用 ./deploy.sh proxy external 或 ./deploy.sh proxy caddy 切换配置。
COMPOSE_PROFILES=

# 应用在宿主机的 HTTP 入口，外部反代转发到此地址和端口。
# 默认只监听本机；应用端口范围 1024–65535，不能使用 3080。
RP_APP_BIND_IP=127.0.0.1
RP_APP_PORT=18767

# 可选：已有的 Docker 反代网络名称；留空不接入共享网络。
# deploy.sh 会按此值加载网络配置，上游为 pi-roleplay-app:3091
# （其中 pi-roleplay 对应 COMPOSE_PROJECT_NAME）。
RP_PROXY_NETWORK=

# Caddy 配置：仅在 COMPOSE_PROFILES=caddy 时监听以下端口。
# HTTPS 部署时 RP_SITE_ADDRESS 与 RP_PUBLIC_ORIGIN 保持一致。
# 本机 HTTP 调试请通过 configure 的 HTTP origin 参数生成对应配置。
RP_SITE_ADDRESS=https://rp.example.com
RP_BIND_IP=0.0.0.0
RP_HTTP_PORT=80
RP_HTTPS_PORT=443

# 持久数据目录，相对路径以项目根目录为基准，也支持绝对路径。
RP_STORAGE_DIR=./state

# 应用与工具镜像标签；deploy.sh build 在本机构建，update 自动写入新版标签。
RP_APP_IMAGE=pi-roleplay-app:0.1.0
RP_TOOLS_IMAGE=pi-roleplay-tools:0.1.0
