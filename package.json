{
  "name": "pi-roleplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted single-user roleplay application powered by Pi",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "dev": "node scripts/dev.ts",
    "dev:server": "tsx watch --clear-screen=false apps/server/src/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:domain": "node scripts/test-domain.mjs",
    "test": "pnpm test:domain && vitest run",
    "build": "node scripts/build.mjs",
    "build:tools": "node scripts/build-tools.mjs",
    "build:server": "node scripts/build-server.mjs",
    "test:tools-container": "node scripts/test-tools-container.mjs",
    "test:server-package": "node scripts/test-server-package.mjs",
    "start": "node apps/server/dist/main.js",
    "start:tools": "node apps/tools/dist/main.js",
    "admin": "tsx apps/server/src/cli.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "test:deployment": "node scripts/test-deployment.mjs",
    "test:backup": "python3 scripts/test-deploy.py",
    "test:entrypoints": "node --import tsx scripts/test-entrypoints.ts",
    "release:check": "node scripts/release.ts check",
    "release:pack": "node scripts/release.ts pack",
    "test:browser:fixture": "tsx tests/browser/server.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.0",
    "@earendil-works/pi-ai": "0.85.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/secure-session": "8.3.0",
    "@fastify/static": "10.1.3",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "i18next": "26.4.2",
    "lucide-react": "1.41.0",
    "motion": "13.2.0",
    "node-pty": "1.1.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "micromark-util-types": "2.0.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
